{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/platanus-hack/platanus-hack-26-cl-team-43/schema/cachai.schema.json",
  "title": ".cachai.json v2",
  "description": "Configuración de la revisión de Cachai. Solo vale la de la rama base: un PR no puede cambiar con qué se lo juzga. Describe dónde está el material reservado, nunca el material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "app"
  ],
  "properties": {
    "version": {
      "const": 2,
      "description": "Versión del formato. Sin este campo se lee como v1 (solo app y tests_dir)."
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cómo levantar la app del PR: module (ASGI con la imagen Python de Cachai), dockerfile (la imagen del repo) o compose (la app y sus servicios).",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
          "description": "Objeto ASGI, p. ej. invoices.main:app. Con dockerfile o compose es opcional: si está, define el comando de arranque."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8000
        },
        "health": {
          "type": "string",
          "pattern": "^/(?!/)",
          "default": "/health",
          "description": "Ruta que responde cuando la app está lista."
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "description": "Dockerfile del repo, relativo, sin .. ni .git. Se construye con el árbol del PR."
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "service"
          ],
          "description": "Compose de la rama base. Cachai lo interpreta (subconjunto permitido); nunca corre docker compose con él.",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$",
              "description": "Servicio que es la app del PR."
            }
          }
        },
        "env": {
          "type": "object",
          "description": "Variables de prueba para la app; salen de la base, nunca del PR.",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "module"
          ]
        },
        {
          "required": [
            "dockerfile"
          ]
        },
        {
          "required": [
            "compose"
          ]
        }
      ],
      "not": {
        "required": [
          "dockerfile",
          "compose"
        ]
      }
    },
    "tests_dir": {
      "type": "string",
      "default": "tests",
      "description": "Carpeta de tests de la rama base, relativa al repo, sin .. ni .git."
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users"
      ],
      "description": "Identidades de prueba y recursos con dueño que el equipo rojo usa para atacar. Las marcas son textos que solo aparecen en el recurso de su dueño.",
      "properties": {
        "users": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,30}$"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers de autenticación de ese usuario."
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owned",
            "required": [
              "id",
              "owner",
              "markers"
            ]
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owned",
            "required": [
              "path",
              "owner",
              "markers"
            ]
          }
        },
        "files_root": {
          "type": "string",
          "pattern": "^/",
          "description": "Raíz absoluta de los adjuntos dentro del contenedor de la app."
        }
      }
    },
    "attacks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families"
      ],
      "description": "Familias de ataque activas. Requiere inventory.",
      "properties": {
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "authz",
              "files",
              "authn",
              "sqli",
              "ssrf",
              "cmdi",
              "writes"
            ]
          }
        }
      }
    },
    "hidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "key_env"
      ],
      "description": "Dónde está el paquete reservado (cifrado) y qué variable del CI tiene su clave.",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "description": "Ruta absoluta, o relativa al repo sin .. ni .git."
        },
        "key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "description": "Siembra los datos de prueba antes de levantar la app. Corre con la imagen construida desde la rama base (nunca la del PR), en la red interna, con las variables de la app y una CACHAI_CANARY_<NOMBRE> por cada marca {{canary:nombre}} del inventario. Requiere app.dockerfile o app.compose.",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "owned": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    }
  }
}
