# PostgreSQL
POSTGRES_USER=cachai
POSTGRES_PASSWORD=cachai_dev_password
POSTGRES_DB=cachai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cachai:cachai_dev_password@postgres:5432/cachai

# LiteLLM Proxy
LITELLM_MASTER_KEY=sk-cachai-dev-master-key
LITELLM_BASE_URL=http://litellm:4000
# Optional upstream provider keys (leave blank to run in local demo/mock mode)
FIFTYX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent Core & Security
INTERNAL_API_TOKEN=change-me-internal-publish-token
DAILY_BUDGET_USD=5.00
ESTIMATED_AUDIT_COST_USD=0.25
AUDIT_INTERVAL_MINUTES=60
DEMO_MODE=true

# Ephemeral Sandbox (docker-py)
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEM_LIMIT=128m
SANDBOX_TIMEOUT_SECONDS=15

# Web Blog (Next.js)
INTERNAL_API_URL=http://agent-core:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
