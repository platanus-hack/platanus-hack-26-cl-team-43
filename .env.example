# Postgres with pgvector (docker compose locally; Supabase/Neon when hosted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/radar
# GitHub token (public read is enough) for the github_* collectors
GITHUB_TOKEN=
# optional; higher Hugging Face rate limits
HF_TOKEN=
OPENROUTER_API_KEY=
# OpenRouter model ids used for extraction and judging
EXTRACTOR_MODEL=
JUDGE_MODEL=
# hard daily cap on model spend, reset at 00:00 America/Santiago
DAILY_BUDGET_USD=20.0
# email alerts via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp alerts via Twilio (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
# who may log in to the dashboard, comma-separated
ALLOWED_EMAILS=a@example.com,b@example.com
# session signing key: MUST be at least 32 characters
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# public URL used in alert links
BASE_URL=http://localhost:8000
# web server port for `radar run`
PORT=8000
