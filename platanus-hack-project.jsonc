{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Cachai",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "El auditor que detecta, desde afuera, cuándo un proveedor sirve algo distinto del modelo que evaluaste.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Las evaluaciones de seguridad de un modelo valen para ese modelo y esa configuración, pero quien lo usa a través de un proveedor no puede comprobar qué le responde. Cachai le manda las mismas pruebas a cada endpoint y a una referencia, y escribe una ficha que separa lo declarado de lo medido: prompts ocultos, modelo sustituido o degradado, tool calls rotas y filtración del system prompt. Las pruebas se generan en el momento, así un proveedor tramposo no puede reconocer la auditoría y portarse bien solo con ella.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://cachai-ai.vercel.app"
}
